{
  "name": "glyph-graphics",
  "version": "0.2.0",
  "description": "Shape-aware image-to-ASCII conversion with optional Three.js rendering and JSONL video.",
  "author": "Alex Yankov",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./three": {
      "types": "./dist/three/index.d.ts",
      "import": "./dist/three/index.js",
      "require": "./dist/three/index.cjs",
      "default": "./dist/three/index.js"
    },
    "./video": {
      "types": "./dist/video/index.d.ts",
      "import": "./dist/video/index.js",
      "require": "./dist/video/index.cjs",
      "default": "./dist/video/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "RELEASING.md"
  ],
  "keywords": [
    "ascii",
    "ascii-art",
    "glyph",
    "rendering",
    "canvas",
    "webgl",
    "threejs",
    "image-processing"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aleyan/glyph-graphics.git"
  },
  "bugs": {
    "url": "https://github.com/aleyan/glyph-graphics/issues"
  },
  "homepage": "https://github.com/aleyan/glyph-graphics#readme",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.8",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build:js": "bun scripts/build.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "bun run build:js && bun run build:types",
    "demo": "bun examples/demo.ts",
    "demo:browser": "bun --hot examples/browser_demo.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "verify:package": "bun scripts/verify-package.ts",
    "check": "bun test && bun run typecheck && bun run build && bun run verify:package",
    "prepack": "bun run build",
    "prepublishOnly": "bun run check"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "@types/bun": "latest",
    "@types/three": "^0.186.0",
    "three": "^0.186.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "three": "^0.186.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  }
}
