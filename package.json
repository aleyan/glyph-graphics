{
  "name": "glyph-graphics",
  "version": "0.1.0",
  "description": "Alex Harri's shape-aware ASCII converter with an optional Three.js tilemap renderer.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./three": "./src/three/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ascii",
    "ascii-art",
    "glyph",
    "rendering",
    "canvas",
    "webgl"
  ],
  "scripts": {
    "demo": "bun examples/demo.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "@types/bun": "latest",
    "@types/three": "^0.185.1",
    "three": "^0.185.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "three": "^0.185.1"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  }
}
